{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "strict": true, "noUncheckedIndexedAccess": false, "noEmit": true, "skipLibCheck": true,
    "allowJs": true, "checkJs": false, "isolatedModules": true, "resolveJsonModule": true, "types": ["vite/client"]
  },
  "include": ["src/protocol", "src/v2", "src/vite-env.d.ts"]
}
