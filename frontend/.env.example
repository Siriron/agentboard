# Which network loads first for visitors with no saved choice. Default: testnet.
# Flip to mainnet only after contracts are deployed and set in src/lib/networks.js.
VITE_DEFAULT_NETWORK=testnet
# Optional extra mainnet read RPCs (comma separated). Domain-restrict any provider key.
VITE_ARC_MAINNET_RPC_EXTRA=

# Mainnet V2 is ON by default. Set to 0 to show the "launch in progress" gate on the mainnet side.
# VITE_MAINNET_V2=0
# Lower bound for V2 event reads. Default 27766000 (just before the kernel was created, block 27767558).
# VITE_V2_FROM_BLOCK=27766000

# File hosting for deliverables and dispute files uses Vercel Blob. Create a Blob store in the Vercel
# project (Storage tab); Vercel adds BLOB_READ_WRITE_TOKEN automatically. Nothing to set by hand.
