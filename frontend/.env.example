# Which network loads first for visitors with no saved choice. Default: testnet.
# Flip to mainnet only after contracts are deployed and set in src/lib/networks.js.
VITE_DEFAULT_NETWORK=testnet
# Optional extra mainnet read RPCs (comma separated). Domain-restrict any provider key.
VITE_ARC_MAINNET_RPC_EXTRA=

# Mainnet V2 pages (AgentKernel/EvaluatorRouter/JobBoard). Set to 1 on a Preview deploy first.
VITE_MAINNET_V2=0
# Lower bound for V2 event reads: the kernel deployment block from ArcScan.
VITE_V2_FROM_BLOCK=27400000

# ── Server-side only (Vercel project env, never VITE_*): IPFS hosting for deliverables and dispute files
# PINATA_JWT=            Pinata API JWT
# V2_KERNEL=0x...        AgentKernel (mainnet), used to check that the uploader is a party to the job
# V2_ROUTER=0x...        EvaluatorRouter (mainnet)
# ARC_MAINNET_RPC=       optional, defaults to https://rpc.mainnet.arc.io
# PIN_ALLOWED_ORIGINS=   comma list, defaults to https://arc-agentboard.vercel.app (add preview URLs)
